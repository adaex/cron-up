#!/usr/bin/env python3
"""doorman — keep a warm interactive session for scheduled agent tasks.

A launchd-driven concierge. Every interval it scans workspace task files
(e.g. .claude/scheduled_tasks.json), computes which tasks fire within the
lead window, and makes sure an interactive consumer session is alive in that
workspace. It never executes tasks itself — it only opens the door.

Subcommands:
  install     install binary, config and LaunchAgent
  uninstall   remove LaunchAgent (optionally purge everything)
  list        list every task: next fire, cadence, prompt summary, consumer
  run         one patrol round (invoked by launchd every interval)
  renew       mark recurring tasks permanent so they never hit the 7-day expiry
  logs        tail doorman or a session's TUI log

With no subcommand it prints a Chinese at-a-glance overview (service,
config, tasks, warm sessions, alerts) rather than argparse's bare usage
error.
"""

import argparse
import datetime
import fcntl
import glob
import json
import os
import plistlib
import re
import shlex
import shutil
import signal
import stat
import subprocess
import sys
import time
import unicodedata

VERSION = "0.1.8"
LABEL = "local.doorman"

HOME = os.path.expanduser("~")
APP_SUPPORT = os.path.join(HOME, "Library", "Application Support", "doorman")
LOG_DIR = os.path.join(HOME, "Library", "Logs", "doorman")
SESSION_LOG_DIR = os.path.join(LOG_DIR, "sessions")
CONFIG_PATH = os.path.join(APP_SUPPORT, "config.json")
STATE_PATH = os.path.join(APP_SUPPORT, "state.json")
BIN_PATH = os.path.join(HOME, ".local", "bin", "doorman")
PLIST_PATH = os.path.join(HOME, "Library", "LaunchAgents", LABEL + ".plist")

DEFAULT_CONFIG = {
    "version": 1,
    # Home by default (two levels deep covers ~/<root>/<workspace>); tighten
    # with explicit roots at install time.
    "roots": ["~"],
    "maxDepth": 2,
    "intervalSeconds": 300,
    "leadSeconds": 600,
    # During each patrol, mark recurring tasks "permanent" in their task file
    # so Claude Code's 7-day recurring-task expiry never deletes them. Because
    # load_config fills missing keys from these defaults, the first patrol
    # after install OR UPGRADE (configs written before this key existed) tags
    # every existing recurring task. Disable with autoRenew=false in the
    # config (takes effect next round) or `install --force --no-auto-renew`.
    "autoRenew": True,
}

# A warm session that dies while still needed, three times in a row, is
# probably broken (bad env, missing trust…). Back off instead of relaunching
# every 5 minutes forever.
FAIL_LIMIT = 3
COOLDOWN_SECONDS = 1800
# A healthy session registers in ~10s. One that is still alive but has not
# registered long after that is not warming up — it is parked on a prompt
# nobody will answer (folder-trust confirmation, a tool permission request).
# That failure mode keeps the process alive forever, so liveness alone would
# report it as healthy; only this deadline catches it.
WARMUP_GRACE_SECONDS = 180
# A warm session is a cache, not a pet: "permanent" tasks keep it alive
# indefinitely, which pins it to the claude version — and the ever-growing
# typescript — of the day it was spawned. Sessions older than this are
# retired, but only once their typescript has gone silent for a while: a
# quiet log is the evidence no task is mid-flight, so a running task is
# never cut. (If some TUI repaints while idle, the condition simply never
# holds and nothing is retired — a safe degradation.)
SESSION_MAX_AGE_SECONDS = 7 * 86400
SESSION_IDLE_SECONDS = 3600
# TUI typescripts are full-screen render streams and grow unboundedly while a
# long-lived warm session runs. Rotate at spawn time (script(1) truncates on
# open, so rotation granularity is one warm-session life).
LOG_ROTATE_BYTES = 10 * 1024 * 1024
# The patrol log is just a few lines per round, but a machine that runs for
# years deserves a bound. launchd re-opens the path per spawn, so renaming at
# the start of a round is safe: this round's fds keep writing the renamed
# inode, the next round opens a fresh file.
PATROL_LOG_ROTATE_BYTES = 1024 * 1024

# Never descend into VCS/dependency internals, or standard macOS home-system
# folders — an agent workspace never lives there, and ~/Library alone would
# make a home-directory scan enormous.
PRUNE_DIRS = {
    ".git", "node_modules",
    "Library", "Applications", "Desktop", "Documents", "Downloads",
    "Movies", "Music", "Pictures", "Public", ".Trash",
    ".cache", ".npm", ".local", ".config",
}


# ---------------------------------------------------------------- cron ------

def parse_cron_field(expr, lo, hi):
    """Parse one cron field into the set of in-range values it names.

    Values outside the field's legal domain are dropped, not raised: a
    typo like "99" then reads as "this field matches nothing" (surfaced
    via Cron.satisfiable) instead of either crashing the parse or silently
    matching a minute it should not.
    """
    values = set()
    for token in expr.split(","):
        if "/" in token:
            rng, step_s = token.split("/", 1)
            step = int(step_s)  # "/0" raises ValueError, caught upstream
        else:
            rng, step = token, 1
        if rng == "*":
            start, end = lo, hi
        elif "-" in rng:
            a, b = rng.split("-", 1)
            start, end = int(a), int(b)
        else:
            start = end = int(rng)
            if "/" in token:  # vixie: "5/10" means 5,15,25,… up to hi
                end = hi
        values.update(v for v in range(start, end + 1, step)
                      if lo <= v <= hi)
    return values


# Scheduled tasks expire after 7 days (recurring ones are dropped by the
# scheduler; one-shots have fired long before). The patrol therefore never
# needs to look further ahead than that. Display pages are another matter —
# see DISPLAY_SEARCH_DAYS.
SEARCH_DAYS = 7
# `list` and the overview answer "when does this fire next?" for a human, so
# they look a full year ahead: a yearly task must show its date, not a
# misleading "no schedule". The calendar fast-forward in next_after keeps
# the longer window cheap (it only ever skips times _matches would reject).
DISPLAY_SEARCH_DAYS = 366
# Catch-up detection searches forward from a task's creation time instead,
# so it needs its own bound — see task_wanted.
MISSED_LOOKBACK_DAYS = 30
# `list` asks "was this one-shot missed?" — the same catch-up question
# task_wanted answers, minus any look-ahead.
ZERO_LEAD = datetime.timedelta(0)


class Cron:
    """Minute-resolution cron; vixie OR semantics when both DoM and DoW set."""

    def __init__(self, expr):
        m, h, dom, mon, dow = expr.split()
        self.minutes = parse_cron_field(m, 0, 59)
        self.hours = parse_cron_field(h, 0, 23)
        self.doms = parse_cron_field(dom, 1, 31)
        self.months = parse_cron_field(mon, 1, 12)
        # Parse on a 0..7 scale (both 0 and 7 name Sunday) then fold. The
        # fold has to happen after set expansion: a textual replace("7","0")
        # turns the perfectly ordinary range "1-7" (Mon…Sun) into "1-0",
        # which parses to an empty set and silently never fires.
        raw_dows = parse_cron_field(dow, 0, 7)
        self.dows = {v % 7 for v in raw_dows}
        self.dom_restricted = dom != "*"
        self.dow_restricted = dow != "*"
        # A non-empty set per field is necessary but not sufficient (Feb 30
        # still never matches); this flags only expressions that cannot
        # match ANY minute — those deserve a loud "cron 无效" instead of a
        # quiet "无安排" that looks like a task with no upcoming fire.
        self.satisfiable = bool(
            self.minutes and self.hours and self.doms
            and self.months and self.dows)

    def _matches(self, t):
        if t.minute not in self.minutes or t.hour not in self.hours:
            return False
        if t.month not in self.months:
            return False
        cron_dow = (t.weekday() + 1) % 7  # python Mon=0 → cron Sun=0
        if self.dom_restricted and self.dow_restricted:
            return t.day in self.doms or cron_dow in self.dows
        return t.day in self.doms and cron_dow in self.dows

    def next_after(self, after, within_days=SEARCH_DAYS):
        """Next fire time strictly after `after`, or None if not within
        `within_days`. None also covers expressions that can never match."""
        if not self.satisfiable:
            return None
        t = (after + datetime.timedelta(minutes=1)).replace(
            second=0, microsecond=0)
        deadline = after + datetime.timedelta(days=within_days)
        while t <= deadline:
            # Calendar fast-forward: jump over months/hours that cannot match
            # anything, then scan the remainder minute by minute. The jumps
            # only skip times _matches would reject, so results are identical
            # to a naive scan — but a year-long window costs ~10⁴ iterations
            # instead of 5·10⁵, which is what makes DISPLAY_SEARCH_DAYS viable.
            if t.month not in self.months:
                t = (t.replace(day=1, hour=0, minute=0)
                     + datetime.timedelta(days=32)).replace(day=1)
                continue
            if t.hour not in self.hours:
                t = (t + datetime.timedelta(hours=1)).replace(minute=0)
                continue
            if self._matches(t):
                return t
            t += datetime.timedelta(minutes=1)
        return None


def cron_looks_oneshot(expr):
    """Fallback heuristic: CronCreate one-shots look like 'M H DoM Mon *'."""
    parts = expr.split()
    return len(parts) == 5 and parts[4] == "*" and all(
        p.isdigit() for p in parts[:4])


def task_is_oneshot(task):
    # The scheduler writes an explicit "recurring" flag; trust it when present
    # and fall back to cron-shape detection for hand-authored task files.
    if "recurring" in task:
        return not bool(task["recurring"])
    try:
        return cron_looks_oneshot(task["cron"])
    except (KeyError, AttributeError, TypeError):
        return False


def task_wanted(task, now, lead):
    """True if a consumer session must already be warm for this task.

    Every field here comes from a file another program writes, so a malformed
    task must read as "not wanted" — never raise. One bad entry would
    otherwise abort the patrol before the remaining workspaces are visited.
    """
    try:
        cron = Cron(task["cron"])
    except (ValueError, IndexError, KeyError, AttributeError, TypeError):
        return False
    nxt = cron.next_after(now)
    if nxt and nxt <= now + lead:
        return True
    # Still on file though its first fire is past: for a one-shot that means
    # it was missed while no REPL was running (reboot/sleep). The native
    # mechanism catch-up-fires it on session start and then deletes it.
    if task_is_oneshot(task) and task.get("createdAt"):
        try:
            created = datetime.datetime.fromtimestamp(
                task["createdAt"] / 1000)
        except (TypeError, ValueError, OSError, OverflowError):
            return False
        # Searching forward from creation, not from now. Cap the span: a
        # stale entry with an expression that never matches would otherwise
        # scan every minute since it was written. One-shots are created
        # shortly before they fire, so a bounded look-ahead loses nothing
        # real, and anything older than the cap is long dead anyway.
        span = min((now - created).days + 1, MISSED_LOOKBACK_DAYS)
        first = cron.next_after(created - datetime.timedelta(minutes=1),
                                within_days=span)
        if first and first <= now:
            return True
    return False


# --------------------------------------------------------------- display ----

def human_delta(td):
    """倒计时的粗略中文说法，只用于总览页。"""
    secs = max(0, int(td.total_seconds()))
    if secs < 60:
        return "不到 1 分钟"
    if secs < 3600:
        return f"{secs // 60} 分钟后"
    if secs < 86400:
        return f"{secs // 3600} 小时后"
    return f"{secs // 86400} 天后"


def disp_width(s):
    """等宽终端里的显示宽度：东亚宽字符（含中文、全角标点）占两列。"""
    return sum(2 if unicodedata.east_asian_width(c) in ("W", "F") else 1
               for c in s)


def clip(s, width):
    """按显示宽度截断，尾部用省略号 … 占位。"""
    width = max(0, width)
    if disp_width(s) <= width:
        return s
    # 省略号 U+2026 在多数终端占 1 列（EAW Ambiguous），按 2 列预留只是
    # 更保守，结果总宽保证不超过 width。
    keep = width - 2
    out, used = "", 0
    for c in s:
        w = 2 if unicodedata.east_asian_width(c) in ("W", "F") else 1
        if used + w > keep:
            break
        out += c
        used += w
    return out + "…"


def pad(s, width):
    return s + " " * max(0, width - disp_width(s))


def terminal_width():
    return max(60, shutil.get_terminal_size((100, 30)).columns)


def task_summary(task):
    """list/总览上代表任务身份的一句话：prompt 的首个非空行。

    真实任务的第一行通常就是「群人数每日定时任务：……」这种自带标题的
    摘要；取不到时如实标注，不留空白格。
    """
    prompt = task.get("prompt")
    if not isinstance(prompt, str) or not prompt.strip():
        return "（无任务描述）"
    first = next((ln.strip() for ln in prompt.splitlines() if ln.strip()), "")
    return re.sub(r"\s+", " ", first)


def task_view(task, now):
    """把一个任务整理成展示数据。字段来自别的程序写的文件，畸形也不抛。"""
    expr = task.get("cron")
    try:
        cron = Cron(expr)
    except (ValueError, IndexError, KeyError, AttributeError, TypeError):
        return {"valid": False, "expr": expr, "summary": task_summary(task),
                "permanent": False}
    if not cron.satisfiable:
        # Empty field set (out-of-range or backwards range): no minute can
        # ever match. Distinct from "valid but no fire within the display
        # window" (e.g. Feb 30th, which parses fine yet never fires).
        return {"valid": False, "expr": expr, "summary": task_summary(task),
                "permanent": False}
    nxt = cron.next_after(now, within_days=DISPLAY_SEARCH_DAYS)
    oneshot = task_is_oneshot(task)
    # nxt 按定义严格晚于 now，「已错过」完全由 task_wanted 的补执行判定
    # 回答，无需再对 nxt 设防。
    missed = oneshot and task_wanted(task, now, ZERO_LEAD)
    expr_s = expr if isinstance(expr, str) else str(expr)
    return {
        "valid": True, "nxt": nxt, "missed": missed,
        "kind": "一次性" if oneshot else "周期",
        "permanent": bool(task.get("permanent")) and not oneshot,
        "cadence": expr_s,
        "summary": task_summary(task),
    }


# --------------------------------------------------------------- process ---

def alive(pid):
    # TypeError：pid 为 None 等非数值时 int() 抛的是它；OverflowError：
    # 超出 pid_t 的巨大整数（含 Infinity 转 int）。都读作「不存在」。
    try:
        os.kill(int(pid), 0)
        return True
    except (OSError, ValueError, TypeError, OverflowError):
        return False


def proc_started_at(pid):
    """Process start time as ps reports it, or None if the pid is gone.

    Used as an identity fingerprint: macOS recycles pids within hours under
    heavy use, and `kill -0` alone cannot tell our warm session from whatever
    process later inherited its number. Start time pins it down — a recycled
    pid always has a later one.
    """
    # Pin the locale: this string is compared for EXACT equality across
    # invocations, and a manual `doorman run` (terminal LANG, possibly
    # localised) would otherwise format the same process's start time
    # differently from the launchd-driven patrol that spawned it.
    try:
        r = subprocess.run(["/bin/ps", "-p", str(int(pid)), "-o", "lstart="],
                           capture_output=True, text=True, timeout=5,
                           env={**os.environ, "LC_ALL": "C", "LANG": "C"})
    except (OSError, ValueError, subprocess.SubprocessError):
        return None
    out = r.stdout.strip()
    return out or None


def tracked_alive(ent):
    """True only if the pid we recorded is still the process we spawned."""
    if not ent or not ent.get("pid"):
        return False
    reap(ent["pid"])  # a zombie child would otherwise read as alive
    if not alive(ent["pid"]):
        return False
    started = ent.get("procStart")
    if not started:
        return True  # entry from an older version: fall back to kill -0
    return proc_started_at(ent["pid"]) == started


# ----------------------------------------------------- claude code facts ----
#
# Everything below encodes how Claude Code stores tasks and registers
# sessions. It is the one agent tool doorman drives; if a second one ever
# needs supporting, generalise then, against two real implementations rather
# than a guess at what the second one looks like.

TASK_REL = os.path.join(".claude", "scheduled_tasks.json")
SESSION_DIR = os.path.join(HOME, ".claude", "sessions")


def discover(roots, max_depth):
    """Yield (workspace, task file) for every workspace holding a task file."""
    seen = set()
    for root in roots:
        root = os.path.realpath(os.path.expanduser(root)).rstrip("/")
        if not os.path.isdir(root):
            continue
        base = root.count(os.sep)
        for dirpath, dirnames, _ in os.walk(root):
            depth = dirpath.count(os.sep) - base
            if depth >= max_depth:
                dirnames[:] = []
            else:
                dirnames[:] = [d for d in dirnames if d not in PRUNE_DIRS]
            candidate = os.path.join(dirpath, TASK_REL)
            ws = os.path.realpath(dirpath)
            if os.path.isfile(candidate) and ws not in seen:
                seen.add(ws)
                yield ws, candidate


def read_tasks(ws):
    # Task files are external input written by another program: validate
    # the shape rather than trusting it. Anything unexpected reads as "no
    # tasks here" instead of raising into the patrol loop.
    try:
        # encoding 同 load_task_doc：不依赖 locale 的首选编码读中文 prompt
        with open(os.path.join(ws, TASK_REL), encoding="utf-8") as f:
            doc = json.load(f)
    except (OSError, ValueError):
        return None
    if not isinstance(doc, dict):
        return None
    tasks = doc.get("tasks")
    if not isinstance(tasks, list):
        return None
    return [t for t in tasks if isinstance(t, dict)]


class TaskFileChanged(Exception):
    """The task file changed between doorman's read and its write: another
    writer (the Claude Code REPL updating lastFiredAt or deleting a fired
    task) committed first. Never clobber that — drop our rewrite and let the
    next patrol retry on the newer document."""


def load_task_doc(path):
    """Read a task file and return its WHOLE document (unknown top-level keys
    preserved), or None when missing/unreadable/malformed. renew rewrites the
    file in place, so unlike read_tasks it must round-trip every key Claude
    Code or another tool put there, not just the tasks subset."""
    try:
        # Explicit utf-8: launchd spawns us with a minimal environment, and we
        # must not depend on the locale's preferred encoding for user prompts.
        with open(path, encoding="utf-8") as f:
            doc = json.load(f)
    except (OSError, ValueError):
        return None
    if not isinstance(doc, dict) or not isinstance(doc.get("tasks"), list):
        return None
    return doc


def atomic_write_json(path, doc, expected_mtime_ns):
    """Replace `path` atomically, preserving its mode and literal non-ASCII.

    Beside-then-rename: the Claude Code REPL watches this file, and a reader
    must never observe a half-written document. Unlike save_config this keeps
    the original file's permission bits (it is user data doorman does not own)
    and writes Chinese prompts literally rather than as \\u escapes.

    The temp file is created 0600 (never wider) and only relaxed to the
    original mode after writing. expected_mtime_ns is an optimistic-lock: if
    the path's mtime moved since the caller read it, another writer won the
    race, so TaskFileChanged is raised instead of overwriting its update.
    """
    try:
        mode = stat.S_IMODE(os.stat(path).st_mode)
    except OSError:
        mode = 0o600
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8",
              opener=lambda p, flags: os.open(p, flags, 0o600)) as f:
        json.dump(doc, f, indent=2, ensure_ascii=False)
        f.flush()
        os.fchmod(f.fileno(), mode)
    try:
        current = os.stat(path).st_mtime_ns
    except OSError:
        current = None
    if current != expected_mtime_ns:
        os.unlink(tmp)
        raise TaskFileChanged(path)
    os.replace(tmp, path)


def renew_workspace(taskfile):
    """Tag every recurring task that lacks a truthy "permanent" flag.

    Returns the number tagged (file rewritten once), 0 when the file is
    already fully tagged (left byte-for-byte untouched — the idempotency that
    keeps a 5-minute patrol from rewriting another program's file forever),
    None when the file is unreadable/malformed, or "changed" when another
    writer modified it mid-update (rewrite dropped; next patrol retries).
    One-shots and flagless hand-authored files are never modified.
    """
    try:
        mtime_ns = os.stat(taskfile).st_mtime_ns
    except OSError:
        return None
    doc = load_task_doc(taskfile)
    if doc is None:
        return None
    tagged = 0
    for t in doc["tasks"]:
        # Truthiness, not `is True`: that matches Claude Code's own loader
        # (...o.permanent && {permanent:true}), so anything it already treats
        # as permanent counts and is not rewritten. Only an explicitly
        # recurring task is eligible — periodicity is never inferred from cron
        # shape here, and one-shots are left alone.
        if isinstance(t, dict) and t.get("recurring") and not t.get("permanent"):
            t["permanent"] = True
            tagged += 1
    if tagged == 0:
        return 0
    try:
        atomic_write_json(taskfile, doc, mtime_ns)
    except TaskFileChanged:
        return "changed"
    return tagged


# npm/bun 形态的 claude 是解释器跑的脚本：进程 comm 是 node/bun/deno，
# 只能从完整命令行里认 claude 入口路径（bin/claude 符号链接，或包目录
# 下的 cli.js）。回退只对已知解释器开放——任何命令行里碰巧提到 claude
# 的进程（vim claude.md）不会被误认。
_INTERPRETER_COMMS = {"node", "nodejs", "bun", "deno"}
_CLAUDE_ENTRY_RE = re.compile(r"(?:^|/)claude(?:-code)?(?:\.js)?(?:$|[/\s])")


def _ps(pid, fmt):
    try:
        r = subprocess.run(["/bin/ps", "-p", str(pid), "-o", fmt],
                           capture_output=True, text=True, timeout=5)
    except (OSError, ValueError, subprocess.SubprocessError):
        return ""
    return r.stdout.strip()


def _pid_is_claude(pid):
    """Does the live pid look like a Claude Code process? Caller checks
    liveness first; this confirms a recycled PID did not inherit the number
    from an unrelated process."""
    comm = os.path.basename(_ps(pid, "comm=")).lower()
    if "claude" in comm:
        return True
    if comm in _INTERPRETER_COMMS:
        return bool(_CLAUDE_ENTRY_RE.search(_ps(pid, "args=").lower()))
    return False


def read_session_file(path):
    """读一个会话登记文件；读不出返回 None。

    登记是 Claude Code 以 UTF-8 写的，显式指定编码（同 load_task_doc）。
    它会就地重写登记（2.1.281 实测读到过半成品文件）：解析失败睡一拍
    重读一次，仍失败才放弃——否则读写相撞的这一轮会把该工作区误判成
    「无会话」，在用户会话旁边多拉一个。文件消失（OSError）不是竞态，
    不重试。
    """
    for attempt in range(2):
        try:
            with open(path, encoding="utf-8") as fh:
                return json.load(fh)
        except OSError:
            return None
        except ValueError:
            if attempt:
                return None
            time.sleep(0.1)


def scan_sessions():
    """Read the session registry once per patrol/page.

    Returns (workspaces_with_a_live_consumer, registry_alert). The registry
    is another program's undocumented output: if its shape changes we fail
    SILENTLY — every session reads as "absent", so patrols kill and respawn
    their warm sessions in a loop. The alert is the canary for that, armed
    for three distinct drift shapes: no file parses as interactive (kind
    changed), live processes are all non-claude (launch shape changed),
    and interactive registrations yield no usable pid/cwd (fields renamed).
    """
    files = glob.glob(os.path.join(SESSION_DIR, "*.json"))
    interactive = []
    for f in files:
        s = read_session_file(f)
        if isinstance(s, dict) and s.get("kind") == "interactive":
            interactive.append(s)

    consumers = set()
    comm_cache = {}
    live_other = 0
    # 登记能认出 interactive，却读不出有效 pid 或工作目录的条目数：
    # pid/cwd 字段改名或缺失就是这种形态，而下面两条自检分别只看
    # kind 与进程形态，都兜不住它——这是第三条自检的计数。
    suspect = 0
    for s in interactive:
        # pid 也是外部程序写的字段：null、非数值、非正数、超出 pid_t
        # 的巨大整数（json 还会读进 Infinity）都读不出活进程。这段代码
        # 在 per-workspace 保护圈之外，一个畸形登记抛出去就是整轮巡检
        # 失败；而缺失时兜底 -1 会被 kill(-1, 0)（对全部进程的权限探测，
        # 不是存在性检查）误读为存活。
        pid = s.get("pid")
        try:
            pid = int(pid)
        except (TypeError, ValueError, OverflowError):
            suspect += 1  # 正常登记必带可解析的 pid：缺失/变质即字段漂移
            continue
        if pid <= 0:
            suspect += 1
            continue
        if not alive(pid):
            continue  # 进程已退出的陈旧登记：正常现象（崩溃会留下），不计
        if pid not in comm_cache:
            comm_cache[pid] = _pid_is_claude(pid)  # ps calls cached per pid
        if comm_cache[pid]:
            # cwd 同样不可信：非字符串（登记格式变更、文件损坏）当
            # 「定位不到工作区」处理，不给 realpath 抛 TypeError 的机会；
            # 空串与相对路径也不行——realpath 会拿巡检进程自己的 cwd
            # 拼出一个不存在的「消费者」目录，可能令预热被静默跳过。
            cwd = s.get("cwd")
            if isinstance(cwd, str) and os.path.isabs(cwd):
                cwd = os.path.realpath(cwd)
                if cwd:
                    consumers.add(cwd)
                    continue
            suspect += 1  # 活着的 claude 却没有可用 cwd：cwd 字段漂移
        else:
            live_other += 1

    alert = None
    if files and not interactive:
        alert = (f"会话登记目录 {SESSION_DIR} 下有 {len(files)} 个登记文件，"
                 "但没有一个是 interactive 会话；Claude Code 的会话登记"
                 "格式可能已变更，doorman 将识别不到任何现有会话")
    elif live_other and not consumers:
        alert = ("会话登记中的存活进程都不是 claude 命令；Claude Code 的启动"
                 "形态可能已变更，doorman 可能反复重拉会话")
    elif suspect and not consumers:
        alert = ("会话登记中的 interactive 会话都读不出有效的 pid 或工作"
                 "目录；Claude Code 的会话登记字段可能已变更，doorman 会把"
                 "已有会话误判为不存在，在同目录重复拉起会话")
    return consumers, alert


def session_argv(ws, log_path):
    # -l -i are both mandatory. -i loads the interactive rc where the
    # private endpoint/model routing (claude shell function) lives;
    # -l loads /etc/zprofile → path_helper, which is the only thing that
    # puts homebrew (hence fnm/node) on PATH in launchd's minimal
    # environment. A bare -ic works from a terminal only by inheriting a
    # ready PATH, and dies with "fnm: command not found" under launchd.
    return ["/usr/bin/script", "-q", log_path,
            "/bin/zsh", "-lic", f"cd {shlex.quote(ws)} && claude"]


# ---------------------------------------------------------------- config ----

def normalize_roots(roots):
    # Shell tilde expansion only fires at the start of a word, so an argument
    # like "--roots ~/a,~/b" arrives as "/home/u/a,~/b" — the second entry
    # keeps its tilde. Normalise on both read and write so config always stores
    # plain absolute paths regardless of how the shell mangled the input.
    # 非字符串元素（手改 config 混入数字等）跳过，不在 .strip() 上崩掉。
    return [os.path.abspath(os.path.expanduser(r.strip()))
            for r in roots if isinstance(r, str) and r.strip()]


def _is_int(x):
    """配置数值校验用：bool 是 int 的子类，true 不能冒充合法的秒数/深度。"""
    return isinstance(x, int) and not isinstance(x, bool)


def load_config(path=CONFIG_PATH, missing_ok=False, corrupt_ok=False):
    """Load config, exiting legibly on damage.

    `missing_ok` lets the human-facing pages report an absent file as part
    of their output (by raising OSError); `corrupt_ok` does the same for a
    file that exists but is not valid JSON (raises ValueError). Every other
    entry point — launchd's `run` above all — should die with a one-line
    reason instead of a traceback nobody reads.
    """
    try:
        with open(path) as f:
            cfg = json.load(f)
    except OSError:
        if missing_ok:
            raise
        print(f"配置文件读不到：{path}\n  运行 doorman install 生成，"
              f"或用 --config 指定路径", file=sys.stderr)
        sys.exit(2)
    except ValueError as e:
        if corrupt_ok:
            raise
        print(f"配置文件不是合法 JSON：{path}\n  {e}", file=sys.stderr)
        sys.exit(2)
    if not isinstance(cfg, dict):
        # 合法 JSON 但顶层不是对象（手改成 123、["a"]）：dict.update 会
        # 在这里抛 TypeError/ValueError，launchd 入口每轮 traceback——
        # 与「不是合法 JSON」同等对待，死成一行人能读的原因。
        if corrupt_ok:
            raise ValueError(f"配置文件顶层不是 JSON 对象：{path}")
        print(f"配置文件顶层应是 JSON 对象而不是"
              f"{type(cfg).__name__}：{path}\n"
              f"  运行 doorman install 生成，或用 --config 指定路径",
              file=sys.stderr)
        sys.exit(2)
    merged = dict(DEFAULT_CONFIG)
    merged.update(cfg)
    # Type-coerce hand-edited configs: a string roots would otherwise be
    # iterated character by character, and a non-int maxDepth would crash
    # os.walk depth comparison.
    if not isinstance(merged.get("roots"), list):
        merged["roots"] = DEFAULT_CONFIG["roots"]
    merged["roots"] = normalize_roots(merged["roots"])
    if not _is_int(merged.get("maxDepth")) or merged["maxDepth"] < 0:
        merged["maxDepth"] = DEFAULT_CONFIG["maxDepth"]
    if not isinstance(merged.get("autoRenew"), bool):
        merged["autoRenew"] = DEFAULT_CONFIG["autoRenew"]
    return merged


def load_state():
    # Our own file, but a hand-edited or truncated one must not take the
    # launchd entry point down — anything but an object reads as "no state".
    try:
        with open(STATE_PATH) as f:
            state = json.load(f)
    except (OSError, ValueError):
        return {}
    if not isinstance(state, dict):
        return {}
    out = {}
    for ws, ent in state.items():
        if not isinstance(ent, dict):
            continue
        # 数值字段在入口处整型化并校验范围。cmd_run 的收尾过滤与总览页
        # 都在 per-workspace 保护圈之外，手改写进字符串/浮点会让
        # waitpid、killpg 抛 TypeError、让 cooldownUntil 与 now 的比较
        # 直接 TypeError；负数 pid 还会被 waitpid/killpg 当成进程组号，
        # 可能误伤无辜进程组。pid_t 是 int32：范围外一律作废；
        # startedAt/cooldownUntil 解析失败按「字段不存在」。fails 同理：
        # 字符串 fails 会让巡检在 fails+1 处抛 TypeError，该工作区从此
        # 每轮都被保护圈拦住，永远等不到会话。
        pid = ent.get("pid")
        try:
            pid = int(pid)
        except (TypeError, ValueError, OverflowError):
            pid = None
        ent["pid"] = pid if pid and 0 < pid <= 2 ** 31 - 1 else None
        for k in ("startedAt", "cooldownUntil", "fails"):
            try:
                if ent.get(k) is not None:
                    ent[k] = int(ent[k])
            except (TypeError, ValueError, OverflowError):
                del ent[k]
        out[ws] = ent
    return out


def save_state(state):
    os.makedirs(APP_SUPPORT, exist_ok=True)
    tmp = STATE_PATH + ".tmp"
    with open(tmp, "w") as f:
        json.dump(state, f, indent=2)
    os.replace(tmp, STATE_PATH)


def save_config(cfg):
    # Atomic, same as state.json: a crashed/partial write must never leave a
    # corrupt config that the launchd entry point then cannot parse.
    os.makedirs(APP_SUPPORT, exist_ok=True)
    tmp = CONFIG_PATH + ".tmp"
    with open(tmp, "w") as f:
        json.dump(cfg, f, indent=2)
    os.replace(tmp, CONFIG_PATH)


def log(msg):
    print(f"{datetime.datetime.now():%Y-%m-%d %H:%M:%S} {msg}", flush=True)


def session_log_path(ws):
    # 转义顺序不能反：先把已有的 _ 翻倍，再把 / 折成 _。/a/b → a_b、
    # /a_b → a__b，两种路径不再共用同一个日志文件（script(1) 启动即截断，
    # 撞名意味着两个工作区互相覆盖记录）。
    slug = ws.strip("/").replace("_", "__").replace("/", "_")
    return os.path.join(SESSION_LOG_DIR, slug + ".log")


def spawn_session(ws):
    """Fork a detached pty-wrapped TUI.

    Returns (pid, procStart) — the start time pins the pid to this specific
    process so a later recycled pid is never mistaken for our session.
    """
    log_path = session_log_path(ws)
    os.makedirs(os.path.dirname(log_path), exist_ok=True)
    try:
        os.chmod(os.path.dirname(log_path), 0o700)
    except OSError:
        pass
    # script(1) opens the typescript without O_APPEND, so it truncates on the
    # next spawn; rotate only the oversized tail of a still-growing session.
    try:
        if (os.path.exists(log_path)
                and os.path.getsize(log_path) > LOG_ROTATE_BYTES):
            old = log_path + ".1"
            if os.path.exists(old):
                os.remove(old)
            os.rename(log_path, old)
    except OSError:
        pass
    argv = session_argv(ws, log_path)
    pid = os.fork()
    if pid == 0:
        try:
            os.umask(0o077)  # typescript may contain task output: 0600
            # Strip any injected Claude Code session markers so the spawned
            # TUI always starts as a standalone top-level session (launchd has
            # none of these; a manual `doorman run` from inside another CC
            # session otherwise inherits CLAUDE_CODE_CHILD_SESSION and gets no
            # transcript / session registration).
            for key in [k for k in os.environ if k.startswith("CLAUDE_CODE_")]:
                del os.environ[key]
            # 自我标识为 doorman 预热会话，供外部观察工具（vscode-agents-explorer）
            # 识别并自动归组。键名刻意不带 CLAUDE_CODE_ 前缀——那批在上一步刚被
            # strip 掉；值必须严格为字符串 "1"（观察侧 === '1' 判定）。
            os.environ["DOORMAN_SESSION"] = "1"
            os.setsid()
            os.chdir(ws)
            null_in = os.open("/dev/null", os.O_RDONLY)
            null_out = os.open("/dev/null", os.O_WRONLY)
            os.dup2(null_in, 0)
            os.dup2(null_out, 1)  # script writes its typescript to log_path
            os.dup2(null_out, 2)
            os.execv(argv[0], argv)
        except Exception:
            os._exit(127)
    return pid, proc_started_at(pid)


# ----------------------------------------------------------------- run ------

def acquire_run_lock():
    """Serialise patrols: a manual `run` overlapping the launchd round must
    exit quietly instead of double-spawning. The fd stays open (and locked)
    for the process lifetime."""
    os.makedirs(APP_SUPPORT, exist_ok=True)
    lock_path = os.path.join(APP_SUPPORT, "run.lock")
    fd = os.open(lock_path, os.O_CREAT | os.O_RDWR, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        os.close(fd)
        return None
    return fd


def reap(pid):
    """Clear a dead child out of the process table.

    Sessions are forked by this process, so after they exit they linger as
    zombies — and `kill -0` reports a zombie as alive. Without this, waiting
    for a terminated session to disappear always burns the full timeout.
    """
    # TypeError/OverflowError：非整数或超出 pid_t 的 pid（load_state 已
    # 整型化，这里是给其他调用方留的兜底），同样无事可做。
    try:
        os.waitpid(pid, os.WNOHANG)
    except (OSError, TypeError, OverflowError):
        pass  # not our child (e.g. `uninstall` in a fresh process)


def stop_session(ent):
    """Terminate a session we spawned, by process group.

    Verifies identity first: state entries outlive the processes they name,
    and signalling a recycled pid would kill an unrelated process group.
    """
    if not tracked_alive(ent):
        return False
    pid = ent["pid"]
    try:
        os.killpg(pid, signal.SIGTERM)
    except OSError:
        return False
    for _ in range(20):
        time.sleep(0.1)
        reap(pid)
        if not alive(pid):
            return True
    if tracked_alive(ent):
        try:
            os.killpg(pid, signal.SIGKILL)
        except OSError:
            pass
        time.sleep(0.1)
        reap(pid)
    return True


def session_log_idle_seconds(log_path, cur):
    """Seconds since the workspace's typescript was last written. A missing
    log is treated as no sign of activity: it does not block rotation."""
    try:
        return max(0, cur - int(os.path.getmtime(log_path)))
    except OSError:
        return SESSION_IDLE_SECONDS + 1


def list_script_processes():
    """(pid, args) of every live script(1) process.

    The process table is the backstop for a lost state.json: a warm session
    the state file forgot stays invisible to the session registry while it is
    stuck on a prompt, and without this cross-check the patrol would pile a
    second TUI into the same workspace.
    """
    try:
        r = subprocess.run(["/bin/ps", "-axo", "pid=,args="],
                           capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.SubprocessError):
        return []
    procs = []
    for line in r.stdout.splitlines():
        m = re.match(r"\s*(\d+)\s+(/usr/bin/script\s.*)", line)
        if m:
            procs.append((int(m.group(1)), m.group(2)))
    return procs


def rotate_patrol_logs():
    """Rename oversized launchd logs to .1 once per round (see the constant's
    comment for why this is safe despite launchd holding fds)."""
    for name in ("launchd.out.log", "launchd.err.log"):
        path = os.path.join(LOG_DIR, name)
        try:
            if os.path.exists(path) \
                    and os.path.getsize(path) > PATROL_LOG_ROTATE_BYTES:
                old = path + ".1"
                if os.path.exists(old):
                    os.remove(old)
                os.rename(path, old)
        except OSError:
            pass


def cmd_run(args):
    lock_fd = acquire_run_lock()
    if lock_fd is None:
        log("已有一轮巡检在进行，本轮跳过")
        return
    rotate_patrol_logs()
    cfg = load_config(getattr(args, "config", None) or CONFIG_PATH)
    if not _is_int(cfg.get("leadSeconds")) or cfg["leadSeconds"] < 0:
        print(f"配置错误：leadSeconds 必须是非负整数秒，当前为 "
              f"{cfg.get('leadSeconds')!r}", file=sys.stderr)
        sys.exit(2)
    now = datetime.datetime.now()
    lead = datetime.timedelta(seconds=cfg["leadSeconds"])
    state = load_state()
    if not cfg["roots"]:
        log("警告：扫描目录 roots 为空，巡检不会发现任何工作区；"
            "请检查配置文件或用 install --roots 指定")

    cur = int(time.time())
    # Read the registry once: each workspace otherwise globs and forks a ps
    # per registered pid, and the registry self-check belongs here too.
    consumers, registry_alert = scan_sessions()
    if registry_alert:
        log(f"告警：{registry_alert}")
    script_procs = list_script_processes()

    auto_renew = cfg.get("autoRenew")
    for ws, taskfile in discover(cfg["roots"], cfg["maxDepth"]):
        # One unreadable workspace must not abort the patrol: discover() is a
        # generator, so an exception here would skip every workspace after it.
        # Renewal and warming are independently guarded — a failure to tag a
        # task file must never suppress that workspace's session keep-alive.
        if auto_renew:
            try:
                n = renew_workspace(taskfile)
                if isinstance(n, int) and n:
                    log(f"已续期 {ws}：{n} 个周期任务标记为 permanent，"
                        f"不再受 7 天过期限制")
                elif n == "changed":
                    log(f"续期暂缓 {ws}：任务文件刚被 Claude Code 改动，"
                        f"本轮不覆盖，下轮再续")
            except Exception as e:  # noqa: BLE001 — never block the patrol
                log(f"续期错误 {ws}：{type(e).__name__}：{e}")
        try:
            patrol_workspace(ws, state, now, lead, cur, consumers,
                             script_procs)
        except Exception as e:  # noqa: BLE001 — last-resort per-workspace guard
            log(f"错误 {ws}：{type(e).__name__}：{e}")

    # Drop dead entries with no cooldown; keep cooldowns and live sessions.
    state = {
        ws: ent for ws, ent in state.items()
        if tracked_alive(ent) or ent.get("cooldownUntil", 0) > cur
    }
    save_state(state)


def patrol_workspace(ws, state, now, lead, cur, consumers, script_procs=()):
    """Ensure a consumer is warm in one workspace. Mutates `state` in place."""
    tasks = read_tasks(ws)
    ent = state.get(ws)

    if tasks is None:
        # Unreadable task file: never touch a session on evidence this weak.
        return
    if not tasks:
        # The file is intact but holds no tasks any more — a one-shot fired
        # and was deleted, a recurring task expired after 7 days, or the user
        # removed them. A session WE spawned has no reason to stay; the
        # /exit convention closes it promptly, this is the backstop for when
        # that line was forgotten. User-opened sessions are not in `state`
        # and are never touched.
        if ent is not None:
            if tracked_alive(ent):
                stop_session(ent)
                log(f"回收 {ws} pid={ent['pid']}：任务已全部清空，"
                    f"结束保活会话")
            state.pop(ws, None)
        return

    # 换代：长驻会话停留在 spawn 当天的 claude 版本与持续增长的
    # typescript 上。超龄且日志静默（无任务在执行的证据）时主动结束，
    # 需要时下文自然重拉。这不计失败——换代是维护，不是故障。
    mine_alive = tracked_alive(ent)
    if mine_alive:
        age = cur - ent.get("startedAt", cur)
        if age > SESSION_MAX_AGE_SECONDS and session_log_idle_seconds(
                ent.get("log") or session_log_path(ws), cur) \
                > SESSION_IDLE_SECONDS:
            stop_session(ent)
            log(f"换代 {ws} pid={ent['pid']}：会话已连续运行 "
                f"{age // 86400} 天且近期无输出，结束后按需重拉")
            state.pop(ws, None)
            ent = None
            mine_alive = False

    # 登记成功即健康证据：当场清零失败计数，不等「有任务想要会话」的
    # 轮次——健康会话常驻时计数会一直挂着，之后一次无关死亡（重启）
    # 就把陈年计数顶满冷却，连一次新尝试都不给。
    if ent is not None and mine_alive and ws in consumers:
        ent["fails"] = 0

    if not any(task_wanted(t, now, lead) for t in tasks):
        return

    cooling = bool(ent and ent.get("cooldownUntil", 0) > cur)

    if ws in consumers:
        # The task is being consumed. Distinguish our own warm session
        # from the user's interactive session: keep tracking the former
        # (a live consumer proves health → reset the failure streak), and
        # completely let go of the latter.
        if ent is not None:
            if mine_alive:
                ent["fails"] = 0
                state[ws] = ent
            elif not cooling:
                state.pop(ws, None)
        return

    # Alive but not consuming. Healthy only for as long as a real startup
    # takes; past that it is stuck on an unanswerable prompt and will never
    # register, so retire it and let the failure streak advance.
    if mine_alive:
        age = cur - ent.get("startedAt", cur)
        if age <= WARMUP_GRACE_SECONDS:
            return
        stop_session(ent)
        log(f"卡死 {ws} pid={ent['pid']}：进程已存活 {age} 秒仍未登记会话，"
            f"已终止（排查：doorman logs {os.path.basename(ws)}）")

    if cooling:
        return

    # No consumer, and our tracked session (if any) is dead or was just
    # retired as stuck.
    if ent and ent.get("cooldownUntil"):
        # Cooldown just elapsed: grant one clean probationary spawn
        # instead of immediately re-tripping the limit.
        fails = 0
    else:
        fails = (ent or {}).get("fails", 0) + (1 if ent else 0)

    if fails >= FAIL_LIMIT:
        state[ws] = {"pid": None, "fails": fails,
                     "cooldownUntil": cur + COOLDOWN_SECONDS}
        log(f"冷却 {ws}：仍有任务需要会话，但保活会话连续失败 {fails} 次，"
            f"暂停重试 {COOLDOWN_SECONDS // 60} 分钟")
        return

    if ent is None:
        # state 里没有记录不等于没有会话：state.json 丢失（手删、
        # --purge 时保留会话）后，进程表里可能还躺着一个本工作区的
        # script 会话。它若卡在提问界面上就不会出现在会话登记里，直接
        # 再拉一个就是同目录双开。认回进程表里的孤儿，重新纳入正常
        # 生命周期（卡死的 3 分钟后会被照退休处理）。
        log_path = session_log_path(ws)
        for proc_pid, proc_args in script_procs:
            # alive 复核：快照拍于本轮开头，可能含着刚被换代/回收杀掉的
            # pid——把死人认回来会白记一次失败。
            if f"-q {log_path} " in proc_args and alive(proc_pid):
                state[ws] = {"pid": proc_pid, "startedAt": cur,
                             "procStart": proc_started_at(proc_pid),
                             "fails": 0, "log": log_path}
                log(f"接管 {ws} pid={proc_pid}：state 记录缺失，但进程"
                    f"表里仍有本工作区的保活会话，重新纳入跟踪")
                return

    pid, started = spawn_session(ws)
    state[ws] = {"pid": pid, "startedAt": cur, "procStart": started,
                 "fails": fails, "log": session_log_path(ws)}
    log(f"已启动 {ws} pid={pid}（连续失败计数 {fails}）")


def cmd_renew(args):
    """Tag every recurring task permanent immediately.

    Unlike the patrol hook this ignores cfg.autoRenew — running the command is
    itself the explicit instruction. It shares the patrol lock so it cannot
    rewrite a task file while a patrol is mid-flight, reports each workspace,
    and ends with one summary line.
    """
    lock_fd = acquire_run_lock()
    if lock_fd is None:
        log("已有一轮巡检（或另一次 renew）在进行，请稍后重试")
        return
    cfg = load_config(getattr(args, "config", None) or CONFIG_PATH)
    files = tagged = unchanged = 0
    skipped = []
    for ws, taskfile in discover(cfg["roots"], cfg["maxDepth"]):
        files += 1
        err = None
        try:
            n = renew_workspace(taskfile)
        except Exception as e:  # noqa: BLE001 — one bad file never aborts the run
            n, err = None, f"{type(e).__name__}：{e}"
        if n is None:
            why = f"（{err}）" if err else "任务文件读不出或格式损坏"
            print(f"跳过 {ws}：{why}")
            skipped.append(ws)
        elif n == "changed":
            print(f"暂缓 {ws}：任务文件刚被 Claude Code 改动，本次未写入，"
                  f"可再跑一次")
            skipped.append(ws)
        elif n:
            tagged += n
            print(f"已续期 {ws}：{n} 个周期任务标记为 permanent")
        else:
            unchanged += 1
            print(f"已是最新 {ws}：周期任务均已 permanent，无需改动")
    print()
    line = (f"扫描 {files} 个任务文件：本次续期 {tagged} 个任务，"
            f"{unchanged} 个文件无需改动")
    if skipped:
        line += f"，{len(skipped)} 个跳过"
    print(line)
    if tagged:
        print("这些周期任务此后不再受 7 天过期限制；为它们保活的后台会话会长期常驻。")


# --------------------------------------------------------------- install ----

def render_plist(interval):
    return {
        "Label": LABEL,
        "ProgramArguments": [BIN_PATH, "run"],
        "StartInterval": interval,
        "RunAtLoad": True,
        "StandardOutPath": os.path.join(LOG_DIR, "launchd.out.log"),
        "StandardErrorPath": os.path.join(LOG_DIR, "launchd.err.log"),
    }


def launchctl(*args, check=True):
    return subprocess.run(["/bin/launchctl", *args], capture_output=True,
                          text=True, check=check)


def on_disk_case(path):
    """路径在磁盘上真实存储的大小写形态；任何一段读不出时原样返回。

    macOS 默认文件系统大小写不敏感，而 realpath 并不规范化大小写（实测）：
    敲错大小写的 roots 照样通过 isdir，但 discover 产出的工作区路径会带着
    错误的大小写，与 Claude Code 登记的真实 cwd 永远匹配不上，消费者判断
    随之静默失效（同目录被再拉一个会话）。逐段从目录列表里认回真实写法，
    供安装/总览校验比对。
    """
    parts = []
    p = path.rstrip(os.sep) or os.sep
    while True:
        head, tail = os.path.split(p)
        if not tail:
            break
        parts.append(tail)
        p = head
    cur = p  # 循环结束时 p 已停在根
    for name in reversed(parts):
        try:
            match = next(e for e in os.listdir(cur)
                         if e.lower() == name.lower())
        except (OSError, StopIteration):
            return path
        cur = os.path.join(cur, match)
    return cur


def validate_config(cfg, announce=print):
    """Soft checks (non-fatal): prints and returns warning strings."""
    warnings = []
    if not cfg.get("roots"):
        warnings.append("扫描目录 roots 为空：巡检不会发现任何工作区，"
                        "doorman 形同空转")
    interval = cfg.get("intervalSeconds")
    lead = cfg.get("leadSeconds")
    if _is_int(interval) and _is_int(lead) \
            and interval > 0 and 0 <= lead < interval:
        warnings.append(
            f"leadSeconds={lead} 小于 intervalSeconds={interval}：任务可能在"
            f"两轮巡检之间到期而来不及提前启动会话，建议 lead ≥ interval")
    for root in cfg.get("roots", []):
        if not os.path.isdir(root):
            warnings.append(f"扫描目录不存在，巡检不会覆盖它：{root}")
            continue
        real_case = on_disk_case(root)
        if real_case != root:
            warnings.append(
                f"扫描目录的大小写与磁盘实际不符（应为 {real_case}）：{root}；"
                f"会话登记按真实路径匹配，不一致会导致同目录重复拉起会话")
    for w in warnings:
        announce(f"警告：{w}")
    return warnings


def gui_target():
    return f"gui/{os.getuid()}"


def cmd_install(args):
    os.makedirs(APP_SUPPORT, exist_ok=True)
    os.makedirs(SESSION_LOG_DIR, exist_ok=True)
    try:
        os.chmod(SESSION_LOG_DIR, 0o700)
    except OSError:
        pass

    if os.path.exists(CONFIG_PATH) and not args.force:
        # 显式传 path：load_config 的默认参数在定义时绑定，测试替换
        # 模块级 CONFIG_PATH 后默认参数仍指向旧值。
        cfg = load_config(CONFIG_PATH)
        print(f"保留现有配置：{CONFIG_PATH}"
              f"（需要更新时加 --force）")
    else:
        # Even with --force, start from the existing config (or defaults on a
        # fresh install) and only override fields given on the command line —
        # otherwise `install --force --interval 600` would silently reset
        # roots to the default.
        cfg = dict(DEFAULT_CONFIG)
        if os.path.exists(CONFIG_PATH):
            try:
                with open(CONFIG_PATH) as f:
                    old = json.load(f)
            except ValueError:
                old = None
            # 手改成合法 JSON 但不是对象（123、["a"]）：没有可继承的
            # 旧值，静默按默认走；dict.update 会直接抛 TypeError。
            if isinstance(old, dict):
                cfg.update(old)
        overrides = {}
        if args.roots:
            # 显式给了参数却解析不出任何有效目录（--roots , 之类），必是
            # 手误；静默写进配置会让巡检从此空转。
            roots = normalize_roots(args.roots.split(","))
            if not roots:
                print(f"--roots 解析后没有有效目录：{args.roots!r}",
                      file=sys.stderr)
                sys.exit(1)
            overrides["roots"] = roots
        # `is not None`, not truthiness: --lead 0 ("no lead time") is a legal
        # choice and must not be silently dropped. --interval 0 is illegal but
        # has to reach the validation below to be reported as such.
        if args.interval is not None:
            overrides["intervalSeconds"] = args.interval
        if args.lead is not None:
            overrides["leadSeconds"] = args.lead
        # getattr: a hand-built Namespace (tests, older callers) may omit it.
        # `is not None` so --no-auto-renew (False) is not dropped like a falsy
        # value would be.
        if getattr(args, "auto_renew", None) is not None:
            overrides["autoRenew"] = args.auto_renew
        cfg.update(overrides)
        cfg["roots"] = normalize_roots(cfg.get("roots", []))
        save_config(cfg)
        updated = "、".join(overrides) or "全部默认值"
        print(f"已写入配置：{CONFIG_PATH}（更新字段：{updated}）")

    # Validate the effective config before touching the system: illegal
    # values abort; soft problems (small lead, missing dirs) only warn.
    iv = cfg.get("intervalSeconds")
    lv = cfg.get("leadSeconds")
    if not _is_int(iv) or iv <= 0:
        print(f"intervalSeconds 必须是正整数秒，当前为 {iv!r}", file=sys.stderr)
        sys.exit(1)
    if not _is_int(lv) or lv < 0:
        print(f"leadSeconds 必须是非负整数秒，当前为 {lv!r}", file=sys.stderr)
        sys.exit(1)
    validate_config(cfg)
    if cfg.get("roots") == normalize_roots(DEFAULT_CONFIG["roots"]):
        # 与 README 安全说明同一句话，在配置落定的这一刻当面再说一遍：
        # 全目录扫描会把今后 clone 进来的任何仓库纳入巡检与自动续期。
        print("提示：未指定 --roots，扫描范围是整个用户目录，今后 clone "
              "的仓库也会进入巡检；自动续期会把其中的周期任务永久化。"
              "建议用 --roots 显式限定范围（见 README 安全说明）")

    # Self-copy: the repo is a source, the installed binary stands alone.
    # Atomic, and more load-bearing than it looks: launchd runs this very path
    # every interval, so a truncate-then-write would let a patrol read a
    # half-written file and die with SyntaxError — silently, since the service
    # stays "loaded" and only the error log shows it. Write beside, rename over.
    src = os.path.realpath(__file__)
    os.makedirs(os.path.dirname(BIN_PATH), exist_ok=True)
    if os.path.realpath(BIN_PATH) != src:
        tmp = BIN_PATH + ".tmp"
        with open(src, "rb") as fsrc, open(tmp, "wb") as fdst:
            fdst.write(fsrc.read())
        os.chmod(tmp, 0o755)
        os.replace(tmp, BIN_PATH)
        print(f"已安装命令行：{BIN_PATH}")

    with open(PLIST_PATH, "wb") as f:
        plistlib.dump(render_plist(cfg["intervalSeconds"]), f,
                      fmt=plistlib.FMT_XML)
    print(f"已写入 LaunchAgent：{PLIST_PATH}")

    launchctl("bootout", f"{gui_target()}/{LABEL}", check=False)
    r = launchctl("bootstrap", gui_target(), PLIST_PATH, check=False)
    if r.returncode != 0:
        print(f"加载到 launchd 失败：\n{r.stderr.strip()}", file=sys.stderr)
        sys.exit(1)
    launchctl("enable", f"{gui_target()}/{LABEL}", check=False)
    print("已加载到 launchd")

    cmd_run(argparse.Namespace(config=None))
    print("首轮巡检完成，查看状态：doorman")


def cmd_uninstall(args):
    r = launchctl("bootout", f"{gui_target()}/{LABEL}", check=False)
    if r.returncode == 0:
        print("已从 launchd 卸载")

    # 服务没了就没有回收者：默认结束自己启动的保活会话，不留以 bypass
    # 权限空转的孤儿。--keep-sessions 显式保留（例如马上会重装）。
    if not getattr(args, "keep_sessions", False):
        for ws, ent in load_state().items():
            if tracked_alive(ent):
                print(f"正在结束保活会话 {ws} pid={ent['pid']}")
                stop_session(ent)

    if os.path.exists(PLIST_PATH):
        os.remove(PLIST_PATH)
        print(f"已删除 {PLIST_PATH}")

    if args.purge:
        for path in (APP_SUPPORT, LOG_DIR):
            if os.path.isdir(path):
                shutil.rmtree(path)
                print(f"已删除 {path}")
        if os.path.exists(BIN_PATH):
            os.remove(BIN_PATH)
            print(f"已删除 {BIN_PATH}")
    else:
        print("配置与日志已保留（--purge 删除全部产物，"
              "--keep-sessions 保留保活会话）")


# ------------------------------------------------------------- overview ----

def launchctl_info():
    r = launchctl("print", f"{gui_target()}/{LABEL}", check=False)
    if r.returncode != 0:
        return None
    info = {}
    for key in ("state", "last exit code"):
        m = re.search(rf"^\s*{re.escape(key)}\s*=\s*(.+)$", r.stdout, re.M)
        if m:
            info[key] = m.group(1).strip()
    m = re.search(r"^\s*run interval\s*=\s*(\d+)\s*seconds", r.stdout, re.M)
    if m:
        info["interval"] = int(m.group(1))
    return info


LAUNCHD_STATES = {"running": "运行中",
                  "not running": "空闲中（按间隔触发）"}


def launchd_state_zh(state):
    # launchd 的 "not running" 是间隔触发型服务两轮之间的正常空闲态，
    # 直译会让人以为服务停了；未识别的值原样保留以便排查。
    return LAUNCHD_STATES.get(state, state if state else "未知")


def service_line(info, plist_exists):
    """服务状态行：launchd 注册态与上次退出码（含未加载/未安装的提示）。"""
    if info:
        return (f"服务：launchd 已加载，{launchd_state_zh(info.get('state'))}，"
                f"上次退出码 {info.get('last exit code', '?')}")
    if plist_exists:
        return "服务：plist 文件存在但未加载，运行 doorman install 重新加载"
    return "服务：未安装，运行 doorman install 安装"


def cmd_overview(args):
    """无子命令时的总览：一眼看清服务、配置、任务、保活会话与需要留意的事。

    它回答的是「现在一切正常吗」：除了汇总现状，还会把巡检视角的异常
    （该有会话却没有、冷却中、cron 损坏、配置与 launchd 不一致）集中
    成一个「需要留意」清单。
    """
    cols = terminal_width()
    print(f"doorman {VERSION} —— 为定时任务提前备好交互会话")

    cfg_path = getattr(args, "config", None) or CONFIG_PATH
    cfg = None
    cfg_error = None
    try:
        cfg = load_config(cfg_path, missing_ok=True, corrupt_ok=True)
    except OSError:
        pass
    except ValueError as e:
        cfg_error = e
    # 数值字段被手改成非整数（如 "600"）：巡检入口会以退出码 2 失败，
    # 总览若不先挡下，自己会在 timedelta(seconds=...) 处 traceback。
    # 判定式与 cmd_run 的守卫保持一致。
    bad_fields = []
    if cfg is not None:
        if not _is_int(cfg.get("intervalSeconds")) \
                or cfg["intervalSeconds"] <= 0:
            bad_fields.append("intervalSeconds")
        if not _is_int(cfg.get("leadSeconds")) \
                or cfg["leadSeconds"] < 0:
            bad_fields.append("leadSeconds")

    info = launchctl_info()
    print(service_line(info, os.path.exists(PLIST_PATH)))

    alerts = []
    # One registry scan for the whole page; it also feeds the self-check.
    consumers, registry_alert = scan_sessions()
    if registry_alert:
        alerts.append(registry_alert)
    state = load_state()
    # Workspaces whose cooldown is reported in the task section with full
    # context, so the session section does not add a blunter duplicate.
    cooling_warned = set()
    # 本轮巡检视野内的工作区集合，供会话部分识别「已无人管理」的保活
    # 会话；配置不可用时保持 None（无法判断视野，不误报）。
    discovered = None
    if cfg_error is not None:
        # 页面不能死在半路：损坏配置是「需要留意」的一种，巡检本身
        # （launchd 入口）仍会以退出码 2 失败，错误详情见 doorman logs。
        print(f"配置：文件损坏，不是合法 JSON：{cfg_path}")
        alerts.append(f"配置损坏，当前每轮巡检都会失败退出；"
                      f"修复 {cfg_path} 或重新运行 doorman install。"
                      f"解析错误：{cfg_error}")
    elif cfg is None:
        print("配置：缺失，运行 doorman install 生成")
    elif bad_fields:
        vals = "、".join(f"{k}={cfg[k]!r}" for k in bad_fields)
        print(f"配置：{'、'.join(bad_fields)} 应为整数秒，当前 {vals}")
        alerts.append(f"配置字段类型不对（{vals}），请修复 {cfg_path}；"
                      f"leadSeconds 不对时每轮巡检都会以退出码 2 失败")
    else:
        actual_iv = info.get("interval") if info else None
        renew_tag = "，自动续期开" if cfg.get("autoRenew") else "，自动续期关"
        if actual_iv is None:
            print(f"巡检：配置为每 {cfg['intervalSeconds']} 秒一轮"
                  f"（服务未加载），提前 {cfg['leadSeconds']} 秒启动会话"
                  f"{renew_tag}")
        else:
            print(f"巡检：每 {actual_iv} 秒一轮，"
                  f"提前 {cfg['leadSeconds']} 秒启动会话{renew_tag}")
            if actual_iv != cfg["intervalSeconds"]:
                alerts.append(
                    f"launchd 实际间隔 {actual_iv} 秒与配置 "
                    f"{cfg['intervalSeconds']} 秒不一致，"
                    f"重新运行 doorman install 后生效")
        suffix = f"（深度 {cfg['maxDepth']}）"
        roots = "、".join(cfg["roots"])
        prefix = "扫描："
        print(prefix
              + clip(roots, cols - disp_width(prefix) - disp_width(suffix))
              + suffix)
        alerts.extend(validate_config(
            cfg, announce=lambda _: None))
        print()
        task_alerts, cooling_warned, discovered = _overview_tasks(
            cfg, cols, consumers, state)
        alerts.extend(task_alerts)

    # 会话状态来自 state.json，与配置无关：未安装或配置损坏时也可能有
    # 残留的保活会话，照常展示。
    alerts.extend(_overview_sessions(cols, state, cooling_warned, discovered))

    if alerts:
        print("需要留意：")
        for a in alerts:
            print(f"  · {clip(a, cols - 4)}")
        print()

    commands = [
        ("list", "逐个列出任务的内容摘要、执行时间与会话状态"),
        ("logs [目录片段] [-f]", "查看巡检日志或后台会话记录"),
        ("run", "立即手动巡检一轮"),
        ("renew", "立即给所有周期任务补 permanent（跳过 7 天过期）"),
        ("install --force", "更新配置并重新安装（全部参数见 --help）"),
    ]
    name_w = max(disp_width(n) for n, _ in commands)
    print("常用命令：")
    for name, desc in commands:
        print(f"  doorman {pad(name, name_w)}  {desc}")


def _overview_tasks(cfg, cols, consumers, state):
    """总览页的任务盘点部分。

    返回 (告警, 已在告警里说明冷却的工作区集合, 本轮发现的工作区集合)。
    第三个返回值供会话部分识别「已移出巡检视野」的保活会话。
    """
    alerts = []
    cooling_warned = set()
    discovered = set()
    now = datetime.datetime.now()
    cur = int(now.timestamp())
    lead = datetime.timedelta(seconds=cfg["leadSeconds"])

    n_ws = n_tasks = unrenewed = 0
    soonest = None
    for ws, _ in discover(cfg["roots"], cfg["maxDepth"]):
        discovered.add(ws)
        try:
            tasks = read_tasks(ws) or []
        except Exception:  # noqa: BLE001 — 总览页不能被一个坏目录带走
            continue
        if not tasks:
            continue
        n_ws += 1
        n_tasks += len(tasks)
        bad, wanted = 0, False
        for t in tasks:
            # Same field-level rule renew_workspace uses: an explicitly
            # recurring task without a truthy permanent flag is still bound by
            # the 7-day expiry. Counted from the raw task, independent of cron
            # validity, so a bad-cron entry still gets the reminder.
            if t.get("recurring") and not t.get("permanent"):
                unrenewed += 1
            v = task_view(t, now)
            if not v["valid"]:
                bad += 1
                continue
            if v["nxt"] and (soonest is None or v["nxt"] < soonest[0]):
                soonest = (v["nxt"], ws, v["summary"])
            if task_wanted(t, now, lead):
                wanted = True
        if bad:
            alerts.append(f"{ws} 有 {bad} 个任务的 cron 无法解析，"
                          f"巡检会跳过{'它们' if bad > 1 else '它'}")
        if wanted and ws not in consumers:
            ent = state.get(ws) or {}
            cooldown = ent.get("cooldownUntil", 0)
            if cooldown > cur:
                # 与「下轮巡检会自动启动」互斥：冷却中就是不会启动，
                # 两条同时出现会自相矛盾，这里合并成一条。
                eta = max(0, (cooldown - cur) // 60)
                alerts.append(
                    f"{ws} 有任务即将执行（或错过待补执行），但保活会话连续"
                    f"失败 {ent.get('fails', '?')} 次正处冷却中，约 {eta} "
                    f"分钟后才会重试；请运行 doorman logs "
                    f"{os.path.basename(ws)} 排查")
                cooling_warned.add(ws)
            else:
                alerts.append(f"{ws} 有任务即将执行（或错过待补执行），"
                              f"但当前没有交互会话，下轮巡检会自动启动")

    print(f"任务：{n_tasks} 个，分布在 {n_ws} 个工作区"
          if n_tasks else "任务：暂无")
    if soonest:
        nxt, ws, summary = soonest
        line = (f"最近：{nxt:%m-%d %H:%M}（{human_delta(nxt - now)}） "
                f"{os.path.basename(ws)} · {summary}")
        print(clip(line, cols))
    if not cfg.get("autoRenew") and unrenewed:
        alerts.append(
            f"自动续期已关闭：{unrenewed} 个周期任务尚未标记 permanent，"
            f"创建满 7 天后会末次执行并被删除。运行 doorman renew 立即续期，"
            f"或在配置中开启 autoRenew")
    return alerts, cooling_warned, discovered


def session_age_zh(started_at, cur):
    """会话年龄的粗粒度中文：长驻会话按天计，否则按分钟。"""
    secs = max(0, cur - started_at)
    if secs >= 86400:
        return f"{secs // 86400} 天"
    return f"{secs // 60} 分钟"


def _overview_sessions(cols, state, suppress_cooling=(), discovered=None):
    """总览页的保活会话部分，数据来自 state.json，与配置状态无关。

    discovered 是本轮巡检视野内的工作区集合（配置不可用时为 None，不做
    越界判断）：活着却不在其中的会话已经无人管理——巡检只为发现范围内
    的工作区服务，视野外的会话不会被回收或换代，必须提示出来。
    """
    alerts = []
    cur = int(time.time())
    live, cooling, dead = [], [], []
    for ws, ent in sorted(state.items()):
        if ent.get("cooldownUntil", 0) > cur:
            cooling.append((ws, ent))
        elif tracked_alive(ent):
            live.append((ws, ent))
        else:
            dead.append(ws)  # 记录仍在、进程已没：下一轮巡检即清理
    tail = ""
    if cooling:
        tail += f"，冷却 {len(cooling)} 个"
    if dead:
        tail += f"，已失效 {len(dead)} 个"
    if live:
        desc = "、".join(
            f"{os.path.basename(ws)}（pid {ent['pid']}，"
            f"已运行 {session_age_zh(ent.get('startedAt', cur), cur)}）"
            for ws, ent in live)
        head = f"会话：保活 {len(live)} 个（"
        # desc 之外的固定部分逐字算宽、desc 按剩余宽度截断；两位数计数下
        # 固定部分 ≤ 46 列，最窄 60 列的终端也放得下整行。
        fixed = disp_width(head) + disp_width(tail) + disp_width("）")
        print(f"{head}{clip(desc, cols - fixed)}）{tail}")
    else:
        print(f"会话：无保活会话{tail}")
    for ws, ent in cooling:
        if ws in suppress_cooling:
            continue  # 任务区已给过带上下文的合并告警
        eta = max(0, (ent["cooldownUntil"] - cur) // 60)
        alerts.append(f"{ws} 保活连续失败 {ent.get('fails', '?')} 次，"
                      f"冷却中，约 {eta} 分钟后重试")
    if discovered is not None:
        for ws, ent in live:
            if ws not in discovered:
                alerts.append(
                    f"{ws} 的保活会话（pid {ent['pid']}）仍在运行，但该目录"
                    f"已不在巡检范围内（任务文件被删或已移出 roots），"
                    f"doorman 不会再回收或换代它；不需要时请自行结束")
    return alerts


def cmd_list(args):
    cfg = load_config(args.config or CONFIG_PATH)
    now = datetime.datetime.now()
    cols = terminal_width()
    blocks = []
    total = 0
    files_seen = 0
    consumers, _ = scan_sessions()
    for ws, _ in discover(cfg["roots"], cfg["maxDepth"]):
        files_seen += 1
        tasks = read_tasks(ws) or []
        if not tasks:
            continue
        views = [task_view(t, now) for t in tasks]
        # 错过待补执行的排最前，然后按下次时间升序，一年内无安排的垫底。
        views.sort(key=lambda v: (
            3 if not v["valid"] else 0 if v["missed"]
            else 1 if v.get("nxt") else 2,
            v.get("nxt") or datetime.datetime.max))
        blocks.append((ws, ws in consumers, views))
        total += len(tasks)

    if not blocks:
        if files_seen:
            print(f"发现 {files_seen} 个任务文件，其中的任务列表均为空")
        else:
            print("配置的扫描目录下没有发现定时任务文件")
        return

    blocks.sort(key=lambda b: b[0])
    print(f"共 {len(blocks)} 个工作区、{total} 个定时任务")

    # 列宽从全部候选文案动态算出（时间戳 "09-25 08:30" 恒为 11 列），
    # 改文案不会静默错位；cadence 列是截断列，取固定上限。
    status_w = max([11] + [disp_width(s)
                           for s in ("cron 无效", "已错过", "一年内无")])
    kind_w = max(disp_width(k) for k in ("一次性", "周期", "周期·永久")) + 1
    cad_w = 16
    # "  " + status + "  " + kind + "  " + cadence + "  " + summary：
    # 每行总宽不超过终端宽度（60 列起步，见 terminal_width）。
    summary_w = max(12,
                    cols - (2 + status_w + 2 + kind_w + 2 + cad_w + 2))
    for ws, consumer, views in blocks:
        print()
        label = "交互会话：有" if consumer else "交互会话：无"
        path_w = cols - disp_width(label) - 1
        print(f"{pad(clip(ws, path_w), path_w)} {label}")
        for v in views:
            if not v["valid"]:
                status, kind, cadence = "cron 无效", "—", "—"
                summary = f"原字段值：{v['expr']!r}；{v['summary']}"
            elif v["missed"]:
                # 一次性任务的触发点已过：下次会话启动时会补执行一次。
                status, cadence, summary = (
                    "已错过", v["cadence"], v["summary"])
                kind = "周期·永久" if v["permanent"] else v["kind"]
            else:
                status = v["nxt"].strftime("%m-%d %H:%M") if v["nxt"] \
                    else "一年内无"
                cadence, summary = v["cadence"], v["summary"]
                kind = "周期·永久" if v["permanent"] else v["kind"]
            print("  " + pad(status, status_w) + "  " + pad(kind, kind_w)
                  + "  " + pad(clip(cadence, cad_w), cad_w) + "  "
                  + clip(summary, summary_w))


def resolve_log_path(workspace, announce=lambda m: print(m, file=sys.stderr)):
    """Pick which log `doorman logs` should tail. Returns None if a named
    workspace matched nothing (caller exits), otherwise a path."""
    if workspace:
        if os.path.isabs(workspace):
            path = session_log_path(os.path.realpath(workspace))
            return path if os.path.exists(path) else None
        # 只匹配当前日志（*.log）：轮转的 .log.1 若参与匹配，轮转过一次
        # 的工作区会永远被报成「匹配到多个」。
        matches = [f for f in glob.glob(os.path.join(SESSION_LOG_DIR, "*.log"))
                   if workspace in os.path.basename(f)]
        if len(matches) > 1:
            announce(f"'{workspace}' 匹配到多个会话日志，请给出更长的片段：")
            for f in sorted(matches):
                announce(f"  {os.path.basename(f)}")
            sys.exit(1)
        return matches[0] if matches else None

    # The patrol log is what "how is doorman doing" means; stderr only
    # collects crashes. Showing stderr whenever it merely exists means a
    # single old failure hides every later healthy round — so lead with the
    # patrol log and point at the errors instead of substituting them.
    out = os.path.join(LOG_DIR, "launchd.out.log")
    err = os.path.join(LOG_DIR, "launchd.err.log")
    if not os.path.exists(out):
        return err
    try:
        if os.path.getsize(err) > 0:
            mtime = datetime.datetime.fromtimestamp(os.path.getmtime(err))
            announce(f"注：{err} 有内容（最后写入 {mtime:%m-%d %H:%M}），"
                     f"巡检若异常先看它")
    except OSError:
        pass
    return out


def cmd_logs(args):
    path = resolve_log_path(args.workspace)
    if not path:
        print(f"在 {SESSION_LOG_DIR} 中找不到与 "
              f"「{args.workspace}」匹配的会话日志", file=sys.stderr)
        sys.exit(1)
    argv = ["/usr/bin/tail"]
    if getattr(args, "follow", False):
        argv.append("-f")
    else:
        argv += ["-n", "100"]
    argv.append(path)
    os.execv(argv[0], argv)


def main():
    parser = argparse.ArgumentParser(
        prog="doorman",
        description="定时任务门房：到点前为对应目录提前备好交互会话。")
    parser.add_argument("--config", help=argparse.SUPPRESS)
    # 不带子命令不是误用：走总览页，而不是抛一段 usage 错误。
    sub = parser.add_subparsers(dest="command")

    p = sub.add_parser("install", help="安装命令行、配置与 LaunchAgent")
    p.add_argument("--roots", help="以逗号分隔的工作区根目录")
    p.add_argument("--interval", type=int, help="巡检间隔（秒）")
    p.add_argument("--lead", type=int, help="提前启动会话的时间（秒）")
    p.add_argument("--force", action="store_true",
                   help="覆盖已有配置")
    p.add_argument("--auto-renew", action=argparse.BooleanOptionalAction,
                   default=None,
                   help="巡检时自动给周期任务补 permanent 以跳过 7 天过期"
                        "（默认开，用 --no-auto-renew 关闭；改它需配合 --force）")
    p.set_defaults(func=cmd_install)

    p = sub.add_parser("uninstall", help="卸载 LaunchAgent")
    p.add_argument("--purge", action="store_true",
                   help="同时删除命令行、配置与日志")
    p.add_argument("--keep-sessions", action="store_true",
                   help="保留 doorman 启动的后台会话（默认卸载时结束）")
    p.set_defaults(func=cmd_uninstall)

    sub.add_parser("list",
                   help="逐个列出定时任务及其下次执行时间").set_defaults(func=cmd_list)
    sub.add_parser("run", help="执行一轮巡检（launchd 入口）").set_defaults(func=cmd_run)
    sub.add_parser("renew",
                   help="立即给所有周期任务补 permanent（跳过 7 天过期）"
                   ).set_defaults(func=cmd_renew)
    p = sub.add_parser("logs", help="查看巡检日志或后台会话记录")
    p.add_argument("-f", "--follow", action="store_true",
                   help="实时跟踪日志")
    p.add_argument("workspace", nargs="?",
                   help="工作区路径或名称片段（默认看巡检日志）")
    p.set_defaults(func=cmd_logs)

    args = parser.parse_args()
    if getattr(args, "func", None) is None:
        cmd_overview(args)
    else:
        args.func(args)


if __name__ == "__main__":
    main()
